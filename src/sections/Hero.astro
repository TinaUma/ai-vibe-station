---
const base = import.meta.env.BASE_URL;
---

<section id="hero" class="hero">
  <div class="container-site hero-inner">

    <!-- LEFT -->
    <div class="hero-left">
      <div class="hero-badge font-mono">
        <span class="badge-dot"></span>
        available for collaboration
      </div>

      <h1 class="hero-name font-head">
        Tina <span class="name-accent">Uma</span>
      </h1>

      <p class="hero-role font-head">
        AI-Driven Product Engineer
      </p>

      <p class="hero-desc">
        Проектирую полезные системы. Выстраиваю логику,
        соединяю AI-инструменты и довожу идеи
        до работающего продукта.
      </p>

      <div class="hero-cta">
        <a href="#projects" class="btn-orange font-head">Смотреть проекты</a>
        <a href="#contact" class="btn-ghost font-head">Написать →</a>
      </div>

      <!-- Vitruvius row -->
      <div class="vitruvius-row">
        <div class="vit-item">
          <span class="vit-latin font-mono">Utilitas</span>
          <span class="vit-ru">Польза</span>
        </div>
        <div class="vit-sep"></div>
        <div class="vit-item">
          <span class="vit-latin font-mono">Firmitas</span>
          <span class="vit-ru">Прочность</span>
        </div>
        <div class="vit-sep"></div>
        <div class="vit-item">
          <span class="vit-latin font-mono">Venustas</span>
          <span class="vit-ru">Красота</span>
        </div>
      </div>
    </div>

    <!-- CENTER: City skyline (decorative) -->
    <div class="hero-city" aria-hidden="true">
      <svg viewBox="0 0 260 320" fill="none" xmlns="http://www.w3.org/2000/svg" class="city-svg">
        <!-- Tall tower left -->
        <rect x="10" y="60" width="36" height="260" stroke="currentColor" stroke-width="0.8"/>
        <line x1="10" y1="100" x2="46" y2="100" stroke="currentColor" stroke-width="0.4" stroke-dasharray="2 3"/>
        <line x1="10" y1="140" x2="46" y2="140" stroke="currentColor" stroke-width="0.4" stroke-dasharray="2 3"/>
        <line x1="10" y1="180" x2="46" y2="180" stroke="currentColor" stroke-width="0.4" stroke-dasharray="2 3"/>
        <line x1="10" y1="220" x2="46" y2="220" stroke="currentColor" stroke-width="0.4" stroke-dasharray="2 3"/>
        <line x1="10" y1="260" x2="46" y2="260" stroke="currentColor" stroke-width="0.4" stroke-dasharray="2 3"/>
        <rect x="16" y="72" width="10" height="14" stroke="currentColor" stroke-width="0.6"/>
        <rect x="30" y="72" width="10" height="14" stroke="currentColor" stroke-width="0.6"/>
        <rect x="16" y="108" width="10" height="14" stroke="currentColor" stroke-width="0.6"/>
        <rect x="30" y="108" width="10" height="14" stroke="currentColor" stroke-width="0.6"/>
        <rect x="16" y="148" width="10" height="14" stroke="currentColor" stroke-width="0.6"/>
        <rect x="30" y="148" width="10" height="14" stroke="currentColor" stroke-width="0.6"/>
        <!-- Spire -->
        <line x1="28" y1="20" x2="28" y2="60" stroke="currentColor" stroke-width="0.8"/>
        <line x1="18" y1="60" x2="38" y2="60" stroke="currentColor" stroke-width="0.8"/>

        <!-- Wide building center -->
        <rect x="60" y="130" width="80" height="190" stroke="currentColor" stroke-width="0.8"/>
        <line x1="60" y1="170" x2="140" y2="170" stroke="currentColor" stroke-width="0.4" stroke-dasharray="2 3"/>
        <line x1="60" y1="210" x2="140" y2="210" stroke="currentColor" stroke-width="0.4" stroke-dasharray="2 3"/>
        <line x1="60" y1="250" x2="140" y2="250" stroke="currentColor" stroke-width="0.4" stroke-dasharray="2 3"/>
        <line x1="60" y1="290" x2="140" y2="290" stroke="currentColor" stroke-width="0.4" stroke-dasharray="2 3"/>
        <rect x="70" y="145" width="14" height="18" stroke="currentColor" stroke-width="0.6"/>
        <rect x="90" y="145" width="14" height="18" stroke="currentColor" stroke-width="0.6"/>
        <rect x="110" y="145" width="14" height="18" stroke="currentColor" stroke-width="0.6"/>
        <rect x="70" y="183" width="14" height="18" stroke="currentColor" stroke-width="0.6"/>
        <rect x="90" y="183" width="14" height="18" stroke="currentColor" stroke-width="0.6"/>
        <rect x="110" y="183" width="14" height="18" stroke="currentColor" stroke-width="0.6"/>
        <rect x="70" y="223" width="14" height="18" stroke="currentColor" stroke-width="0.6"/>
        <rect x="90" y="223" width="14" height="18" stroke="currentColor" stroke-width="0.6"/>
        <rect x="110" y="223" width="14" height="18" stroke="currentColor" stroke-width="0.6"/>
        <!-- Entrance -->
        <rect x="90" y="290" width="20" height="30" stroke="currentColor" stroke-width="0.6"/>

        <!-- Right tower -->
        <rect x="160" y="90" width="44" height="230" stroke="currentColor" stroke-width="0.8"/>
        <line x1="160" y1="130" x2="204" y2="130" stroke="currentColor" stroke-width="0.4" stroke-dasharray="2 3"/>
        <line x1="160" y1="170" x2="204" y2="170" stroke="currentColor" stroke-width="0.4" stroke-dasharray="2 3"/>
        <line x1="160" y1="210" x2="204" y2="210" stroke="currentColor" stroke-width="0.4" stroke-dasharray="2 3"/>
        <line x1="160" y1="250" x2="204" y2="250" stroke="currentColor" stroke-width="0.4" stroke-dasharray="2 3"/>
        <line x1="160" y1="280" x2="204" y2="280" stroke="currentColor" stroke-width="0.4" stroke-dasharray="2 3"/>
        <rect x="168" y="104" width="12" height="16" stroke="currentColor" stroke-width="0.6"/>
        <rect x="186" y="104" width="12" height="16" stroke="currentColor" stroke-width="0.6"/>
        <rect x="168" y="143" width="12" height="16" stroke="currentColor" stroke-width="0.6"/>
        <rect x="186" y="143" width="12" height="16" stroke="currentColor" stroke-width="0.6"/>
        <rect x="168" y="183" width="12" height="16" stroke="currentColor" stroke-width="0.6"/>
        <rect x="186" y="183" width="12" height="16" stroke="currentColor" stroke-width="0.6"/>
        <!-- Stepped top -->
        <rect x="168" y="70" width="28" height="20" stroke="currentColor" stroke-width="0.7"/>
        <rect x="174" y="52" width="16" height="20" stroke="currentColor" stroke-width="0.7"/>

        <!-- Small building far right -->
        <rect x="218" y="200" width="32" height="120" stroke="currentColor" stroke-width="0.7"/>
        <rect x="226" y="212" width="8" height="12" stroke="currentColor" stroke-width="0.5"/>
        <rect x="240" y="212" width="8" height="12" stroke="currentColor" stroke-width="0.5"/>
        <rect x="226" y="238" width="8" height="12" stroke="currentColor" stroke-width="0.5"/>
        <rect x="240" y="238" width="8" height="12" stroke="currentColor" stroke-width="0.5"/>

        <!-- Ground -->
        <line x1="0" y1="320" x2="260" y2="320" stroke="currentColor" stroke-width="1"/>

        <!-- Orange accent dot (antenna light) -->
        <circle cx="28" cy="18" r="2.5" fill="#FF5500" opacity="0.8"/>
        <circle cx="182" cy="50" r="2" fill="#FF5500" opacity="0.6"/>
      </svg>
    </div>

    <!-- RIGHT: Photo -->
    <div class="hero-right">
      <div class="photo-wrap">
        <img src={`${base}/tina.png`} alt="Tina Umasheva" class="hero-photo" />
        <div class="photo-tag font-mono">
          <span>Prompt Engineer</span>
          <span class="tag-sep">/</span>
          <span>Vibe-coder</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .hero {
    padding: 9rem 0 4rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 220px 280px;
    gap: 2.5rem;
    align-items: start;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    animation: fadeUp 0.5s ease both;
  }

  .badge-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--orange);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  /* Name */
  .hero-name {
    font-size: clamp(2.6rem, 5.5vw, 4.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--text);
    white-space: nowrap;
    margin-bottom: 1rem;
    animation: fadeUp 0.5s 0.05s ease both;
  }

  .name-accent { color: var(--orange); }

  /* Role */
  .hero-role {
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
    animation: fadeUp 0.5s 0.1s ease both;
  }

  /* Desc */
  .hero-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: 440px;
    margin-bottom: 2rem;
    animation: fadeUp 0.5s 0.15s ease both;
  }

  /* CTA */
  .hero-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
    animation: fadeUp 0.5s 0.2s ease both;
  }

  .btn-orange {
    padding: 0.7rem 1.6rem;
    background: var(--orange);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    letter-spacing: 0.01em;
    transition: background 0.2s, transform 0.15s;
  }
  .btn-orange:hover { background: var(--orange-dark); transform: translateY(-1px); }
  .btn-orange:active { transform: scale(0.98); }

  .btn-ghost {
    padding: 0.7rem 1.4rem;
    border: 1.5px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 4px;
    transition: border-color 0.2s, color 0.2s;
  }
  .btn-ghost:hover { border-color: var(--orange); color: var(--orange); }

  /* Vitruvius */
  .vitruvius-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-alt);
    border-radius: 6px;
    border-left: 3px solid var(--orange);
    animation: fadeUp 0.5s 0.25s ease both;
  }

  .vit-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .vit-latin {
    font-size: 0.62rem;
    color: var(--orange);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .vit-ru {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text);
  }

  .vit-sep {
    width: 1px;
    height: 32px;
    background: var(--border);
    flex-shrink: 0;
  }

  /* City skyline */
  .hero-city {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    align-self: stretch;
    padding-bottom: 0;
    overflow: hidden;
    animation: fadeUp 0.7s 0.18s ease both;
  }

  .city-svg {
    width: 100%;
    max-width: 260px;
    height: auto;
    color: rgba(0, 0, 0, 0.08);
  }

  /* Photo */
  .hero-right {
    animation: fadeUp 0.6s 0.08s ease both;
  }

  .photo-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-photo {
    width: 100%;
    max-width: 280px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 8%;
    border-radius: 8px;
    display: block;
    box-shadow: var(--shadow-lg);
  }

  .photo-tag {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .tag-sep { color: var(--orange); }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 1024px) {
    .hero-inner { grid-template-columns: 1fr 280px; }
    .hero-city { display: none; }
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .hero-right {
      order: -1;
      display: flex;
      justify-content: center;
    }
    .hero-name { white-space: normal; }
    .hero-photo { max-width: 200px; aspect-ratio: 1/1; }
  }

  @media (max-width: 480px) {
    .vitruvius-row { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    .vit-sep { width: 24px; height: 1px; }
  }
</style>
