---
const principles = [
  {
    num: '01',
    title: 'От задачи до продакшна',
    text: 'Не останавливаюсь на прототипе. SignDrop начался с «мне нужно подписывать документы» — и стал полноценным продуктом с лендингом, кросс-платформенными сборками и реальными пользователями.',
  },
  {
    num: '02',
    title: 'Весь цикл — сама',
    text: 'Архитектура, бэкенд, фронтенд, деплой, инфраструктура, лендинг. Не передаю задачи по цепочке — закрываю целиком.',
  },
  {
    num: '03',
    title: 'AI-first, не AI-only',
    text: 'Claude Code и Cursor — ежедневный инструмент, не эксперимент. Но финальное решение всегда за инженерным мышлением, а не за первым ответом модели.',
  },
  {
    num: '04',
    title: 'Архитектурное мышление',
    text: '10 лет ведущим архитектором научили одному: сначала понять систему целиком, потом строить детали. Это работает и в коде.',
  },
];
---

<section id="approach" class="approach-section">
  <div class="container-site approach-inner">

    <!-- LEFT: text -->
    <div class="approach-left">
      <div class="section-header">
        <span class="section-label">approach</span>
        <h2 class="section-title">Как я работаю</h2>
      </div>
      <div class="principles">
        {principles.map(p => (
          <div class="principle">
            <div class="principle-head">
              <span class="p-num font-mono">{p.num}</span>
              <h3 class="p-title font-head">{p.title}</h3>
            </div>
            <p class="p-text">{p.text}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- RIGHT: architectural SVG -->
    <div class="approach-right" aria-hidden="true">
      <svg class="arch-svg" viewBox="0 0 320 480" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Ground line -->
        <line x1="20" y1="460" x2="300" y2="460" stroke="currentColor" stroke-width="1.5"/>

        <!-- Building A (tall, left) -->
        <rect x="40" y="120" width="80" height="340" stroke="currentColor" stroke-width="1"/>
        <!-- Windows A -->
        <rect x="52" y="140" width="16" height="20" stroke="currentColor" stroke-width="0.8"/>
        <rect x="76" y="140" width="16" height="20" stroke="currentColor" stroke-width="0.8"/>
        <rect x="100" y="140" width="12" height="20" stroke="currentColor" stroke-width="0.8"/>
        <rect x="52" y="176" width="16" height="20" stroke="currentColor" stroke-width="0.8"/>
        <rect x="76" y="176" width="16" height="20" stroke="currentColor" stroke-width="0.8"/>
        <rect x="100" y="176" width="12" height="20" stroke="currentColor" stroke-width="0.8"/>
        <rect x="52" y="212" width="16" height="20" stroke="currentColor" stroke-width="0.8"/>
        <rect x="76" y="212" width="16" height="20" stroke="currentColor" stroke-width="0.8"/>
        <rect x="100" y="212" width="12" height="20" stroke="currentColor" stroke-width="0.8"/>
        <rect x="52" y="248" width="16" height="20" stroke="currentColor" stroke-width="0.8"/>
        <rect x="76" y="248" width="16" height="20" stroke="currentColor" stroke-width="0.8"/>
        <rect x="100" y="248" width="12" height="20" stroke="currentColor" stroke-width="0.8"/>
        <rect x="52" y="284" width="16" height="20" stroke="currentColor" stroke-width="0.8"/>
        <rect x="76" y="284" width="16" height="20" stroke="currentColor" stroke-width="0.8"/>
        <rect x="100" y="284" width="12" height="20" stroke="currentColor" stroke-width="0.8"/>
        <!-- Entrance A -->
        <rect x="68" y="420" width="24" height="40" stroke="currentColor" stroke-width="0.8"/>
        <!-- Floor lines A -->
        <line x1="40" y1="160" x2="120" y2="160" stroke="currentColor" stroke-width="0.4" stroke-dasharray="3 3"/>
        <line x1="40" y1="200" x2="120" y2="200" stroke="currentColor" stroke-width="0.4" stroke-dasharray="3 3"/>
        <line x1="40" y1="240" x2="120" y2="240" stroke="currentColor" stroke-width="0.4" stroke-dasharray="3 3"/>
        <line x1="40" y1="280" x2="120" y2="280" stroke="currentColor" stroke-width="0.4" stroke-dasharray="3 3"/>
        <line x1="40" y1="320" x2="120" y2="320" stroke="currentColor" stroke-width="0.4" stroke-dasharray="3 3"/>
        <line x1="40" y1="360" x2="120" y2="360" stroke="currentColor" stroke-width="0.4" stroke-dasharray="3 3"/>
        <line x1="40" y1="400" x2="120" y2="400" stroke="currentColor" stroke-width="0.4" stroke-dasharray="3 3"/>

        <!-- Building B (medium, right) -->
        <rect x="170" y="200" width="110" height="260" stroke="currentColor" stroke-width="1"/>
        <!-- Windows B -->
        <rect x="182" y="220" width="18" height="22" stroke="currentColor" stroke-width="0.8"/>
        <rect x="210" y="220" width="18" height="22" stroke="currentColor" stroke-width="0.8"/>
        <rect x="238" y="220" width="18" height="22" stroke="currentColor" stroke-width="0.8"/>
        <rect x="182" y="258" width="18" height="22" stroke="currentColor" stroke-width="0.8"/>
        <rect x="210" y="258" width="18" height="22" stroke="currentColor" stroke-width="0.8"/>
        <rect x="238" y="258" width="18" height="22" stroke="currentColor" stroke-width="0.8"/>
        <rect x="182" y="296" width="18" height="22" stroke="currentColor" stroke-width="0.8"/>
        <rect x="210" y="296" width="18" height="22" stroke="currentColor" stroke-width="0.8"/>
        <rect x="238" y="296" width="18" height="22" stroke="currentColor" stroke-width="0.8"/>
        <rect x="182" y="334" width="18" height="22" stroke="currentColor" stroke-width="0.8"/>
        <rect x="210" y="334" width="18" height="22" stroke="currentColor" stroke-width="0.8"/>
        <rect x="238" y="334" width="18" height="22" stroke="currentColor" stroke-width="0.8"/>
        <!-- Entrance B -->
        <rect x="210" y="420" width="30" height="40" stroke="currentColor" stroke-width="0.8"/>
        <!-- Floor lines B -->
        <line x1="170" y1="248" x2="280" y2="248" stroke="currentColor" stroke-width="0.4" stroke-dasharray="3 3"/>
        <line x1="170" y1="286" x2="280" y2="286" stroke="currentColor" stroke-width="0.4" stroke-dasharray="3 3"/>
        <line x1="170" y1="324" x2="280" y2="324" stroke="currentColor" stroke-width="0.4" stroke-dasharray="3 3"/>
        <line x1="170" y1="362" x2="280" y2="362" stroke="currentColor" stroke-width="0.4" stroke-dasharray="3 3"/>
        <line x1="170" y1="400" x2="280" y2="400" stroke="currentColor" stroke-width="0.4" stroke-dasharray="3 3"/>

        <!-- Small building C (between) -->
        <rect x="130" y="340" width="32" height="120" stroke="currentColor" stroke-width="0.8"/>
        <rect x="138" y="354" width="10" height="14" stroke="currentColor" stroke-width="0.6"/>
        <rect x="154" y="354" width="10" height="14" stroke="currentColor" stroke-width="0.6"/>
        <rect x="138" y="382" width="10" height="14" stroke="currentColor" stroke-width="0.6"/>
        <rect x="154" y="382" width="10" height="14" stroke="currentColor" stroke-width="0.6"/>

        <!-- Dimension lines -->
        <line x1="24" y1="120" x2="24" y2="460" stroke="currentColor" stroke-width="0.5" stroke-dasharray="2 4" opacity="0.5"/>
        <line x1="20" y1="120" x2="30" y2="120" stroke="currentColor" stroke-width="0.5" opacity="0.5"/>
        <line x1="20" y1="460" x2="30" y2="460" stroke="currentColor" stroke-width="0.5" opacity="0.5"/>

        <!-- Orange accent: top of building A -->
        <rect x="40" y="110" width="80" height="12" stroke="#FF5500" stroke-width="1" fill="none" opacity="0.6"/>
        <line x1="80" y1="60" x2="80" y2="110" stroke="#FF5500" stroke-width="0.8" stroke-dasharray="4 3" opacity="0.5"/>
        <circle cx="80" cy="56" r="3" fill="#FF5500" opacity="0.7"/>
      </svg>
    </div>

  </div>
</section>

<style>
  .approach-section {
    padding: 5rem 0;
    background: var(--bg);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .approach-inner {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 4rem;
    align-items: center;
  }

  .section-header { margin-bottom: 2.5rem; }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 0.75rem;
  }
  .section-label::before {
    content: '';
    display: inline-block;
    width: 20px; height: 2px;
    background: var(--orange);
  }

  .section-title {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .principles {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .principle {
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--border);
  }
  .principle:first-child { border-top: 1px solid var(--border); }

  .principle-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .p-num {
    font-size: 0.6rem;
    color: var(--orange);
    letter-spacing: 0.1em;
    flex-shrink: 0;
  }

  .p-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  .p-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.75;
    padding-left: 1.75rem;
  }

  /* SVG */
  .approach-right {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .arch-svg {
    width: 100%;
    max-width: 300px;
    color: rgba(0, 0, 0, 0.12);
    height: auto;
  }

  @media (max-width: 860px) {
    .approach-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .approach-right {
      order: -1;
      max-height: 200px;
      overflow: hidden;
    }
    .arch-svg { max-width: 200px; }
  }
</style>
