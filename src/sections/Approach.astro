---
const principles = [
  {
    num: '01',
    title: 'От задачи до продакшна',
    text: 'Не останавливаюсь на прототипе. SignDrop начался с «мне нужно подписывать документы» — и стал полноценным продуктом с лендингом, кросс-платформенными сборками и реальными пользователями.',
  },
  {
    num: '02',
    title: 'Весь цикл — сама',
    text: 'Архитектура, бэкенд, фронтенд, деплой, инфраструктура, лендинг. Не передаю задачи по цепочке — закрываю целиком.',
  },
  {
    num: '03',
    title: 'AI-first, не AI-only',
    text: 'Claude Code и Cursor — ежедневный инструмент, не эксперимент. Но финальное решение всегда за инженерным мышлением, а не за первым ответом модели.',
  },
  {
    num: '04',
    title: 'Архитектурное мышление',
    text: '10 лет ведущим архитектором научили одному: сначала понять систему целиком, потом строить детали. Это работает и в коде.',
  },
];

const flow = [
  { label: 'Задача', sub: 'анализ + декомпозиция' },
  { label: 'Архитектура', sub: 'стек + структура' },
  { label: 'Разработка', sub: 'бэкенд + фронтенд' },
  { label: 'Деплой', sub: 'CI/CD + мониторинг' },
];
---

<section id="approach" class="approach-section">
  <div class="container-site">

    <div class="section-header">
      <span class="section-label">approach</span>
      <h2 class="section-title">Как я работаю</h2>
    </div>

    <!-- Flow chain -->
    <div class="flow-chain">
      {flow.map((step, i) => (
        <>
          <div class="flow-step">
            <span class="flow-num font-mono">0{i + 1}</span>
            <span class="flow-label font-head">{step.label}</span>
            <span class="flow-sub font-mono">{step.sub}</span>
          </div>
          {i < flow.length - 1 && (
            <div class="flow-arrow" aria-hidden="true">→</div>
          )}
        </>
      ))}
    </div>

    <!-- Principles grid -->
    <div class="principles">
      {principles.map(p => (
        <div class="principle">
          <div class="principle-head">
            <span class="p-num font-mono">{p.num}</span>
            <h3 class="p-title font-head">{p.title}</h3>
          </div>
          <p class="p-text">{p.text}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .approach-section {
    padding: 5rem 0;
    background: var(--bg-dark);
    border-top: 1px solid rgba(255,255,255,0.06);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .section-header { margin-bottom: 2.5rem; }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 0.75rem;
  }
  .section-label::before {
    content: '';
    display: inline-block;
    width: 20px; height: 2px;
    background: var(--orange);
  }

  .section-title {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    color: var(--text-on-dark);
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  /* Flow chain */
  .flow-chain {
    display: flex;
    align-items: center;
    gap: 0;
    margin-bottom: 3rem;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(255,255,255,0.08);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    overflow-x: auto;
  }

  .flow-step {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
    min-width: 120px;
    padding: 0 1rem;
  }

  .flow-num {
    font-size: 0.55rem;
    color: var(--orange);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .flow-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-on-dark);
    white-space: nowrap;
  }

  .flow-sub {
    font-size: 0.62rem;
    color: rgba(255,255,255,0.35);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .flow-arrow {
    font-size: 1.1rem;
    color: var(--orange);
    opacity: 0.5;
    flex-shrink: 0;
    padding: 0 0.25rem;
    margin-top: -0.5rem;
  }

  /* Principles */
  .principles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }

  .principle {
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    padding-right: 2rem;
  }
  .principle:nth-child(odd) {
    border-right: 1px solid rgba(255,255,255,0.07);
    padding-right: 2rem;
  }
  .principle:nth-child(even) {
    padding-left: 2rem;
    padding-right: 0;
  }
  .principle:nth-last-child(-n+2) { border-bottom: none; }

  .principle-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .p-num {
    font-size: 0.58rem;
    color: var(--orange);
    letter-spacing: 0.1em;
    flex-shrink: 0;
  }

  .p-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-on-dark);
    letter-spacing: -0.01em;
  }

  .p-text {
    font-size: 0.85rem;
    color: var(--text-on-dark-secondary);
    line-height: 1.75;
    padding-left: 1.75rem;
  }

  @media (max-width: 680px) {
    .principles { grid-template-columns: 1fr; }
    .principle:nth-child(odd) { border-right: none; padding-right: 0; }
    .principle:nth-child(even) { padding-left: 0; }
    .principle:nth-last-child(-n+2) { border-bottom: 1px solid rgba(255,255,255,0.07); }
    .principle:last-child { border-bottom: none; }
    .flow-step { min-width: 100px; }
  }
</style>
