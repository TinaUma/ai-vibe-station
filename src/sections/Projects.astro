---
const projects = [
  {
    id: '01',
    title: 'SignDrop',
    type: 'Web App',
    flagship: true,
    description: 'Полнофункциональный инструмент для подписи PDF и изображений прямо в браузере. Библиотека подписей, удаление фона, текстовые аннотации, история, undo/redo. Полностью локально — данные не покидают устройство.',
    tags: ['Python', 'FastAPI', 'React 19', 'Docker', 'Konva.js'],
    link: 'https://github.com/TinaUma/signdrop',
    liveUrl: 'https://signdrop.tinacodes.space',
    demoLinks: [
      { label: 'Live Demo ↗', url: 'https://signdrop.tinacodes.space' },
      { label: 'signdrop.site ↗', url: 'https://signdrop.site' },
    ],
  },
  {
    id: '02',
    title: 'VisionStyle',
    type: 'Vision AI',
    description: 'Загрузи фото — получи структурированный стиль-паспорт: палитра HEX, материалы, настроение, ключевые слова и вердикт. FastAPI + Next.js + Claude Vision. Задеплоено на HuggingFace.',
    tags: ['Python', 'FastAPI', 'Next.js', 'Claude Vision', 'TypeScript'],
    link: 'https://github.com/TinaUma/VisionStyle',
    liveUrl: 'https://tinaume-visionstyle.hf.space',
  },
  {
    id: '03',
    title: 'PDFsigner Landing',
    type: 'Case Study',
    description: 'Лендинг для PDFsigner, собранный дважды двумя способами: вручную (HTML/CSS) и через Claude Design. Сравнение подходов: скорость vs контроль, прототип vs продакшн.',
    tags: ['HTML', 'CSS', 'Vanilla JS', 'Claude Design'],
    link: 'https://github.com/TinaUma/pdf-signer-landing',
    liveUrl: 'https://tinauma.github.io/pdf-signer-landing/',
    demoLinks: [
      { label: 'HTML/CSS версия', url: 'https://tinauma.github.io/pdf-signer-landing/claude-html/' },
      { label: 'Claude Design версия', url: 'https://tinauma.github.io/pdf-signer-landing/claude-design/' },
    ],
  },
  {
    id: '04',
    title: 'h3llo-vpn',
    type: 'Infrastructure',
    description: 'Переиспользуемый VPN-прокси контейнер (sing-box + VLESS Reality). Любой сервис в Docker-сети получает прокси тремя строками в compose. Порт не торчит наружу — только внутри сети.',
    tags: ['Docker', 'sing-box', 'VLESS', 'bash'],
    link: 'https://github.com/TinaUma/h3llo-vpn-demo',
  },
  {
    id: '05',
    title: 'AI-ассистент SMAIPL',
    type: 'Demo',
    description: 'Разработала и презентовала AI-ассистента в рамках стажировки. Проектирование промтов, логика диалога, демонстрация возможностей LLM.',
    tags: ['Prompt Engineering', 'LLM'],
    link: 'https://www.youtube.com/watch?v=tts6Ujd2lJo',
    isVideo: true,
  },
  {
    id: '06',
    title: 'VoiceScribe',
    type: 'Voice AI',
    description: 'Telegram-бот транскрипции голосовых через Groq Whisper API. Отправь голосовое — получи текст. Сохрани в TXT или PDF.',
    tags: ['Python', 'aiogram', 'Groq Whisper', 'Voice AI'],
    link: 'https://github.com/TinaUma/voicescribe',
  },
];
---

<section id="projects" class="projects-section">
  <div class="container-site">
    <div class="section-header">
      <span class="section-label">projects</span>
      <h2 class="section-title section-title--light">Проекты</h2>
    </div>
    <div class="projects-grid">
      {projects.map(p => (
        <div class={`project-card${p.flagship ? ' project-card--flagship' : ''}`} role="link" tabindex="0" onclick={`window.open('${p.liveUrl ?? p.link}','_blank')`}>
          <div class="card-top">
            <span class="card-id font-mono">{p.id}</span>
            <div class="card-top-right">
              {p.flagship && <span class="card-flagship font-mono">★ flagship</span>}
              <span class="card-type font-mono">{p.type}</span>
            </div>
          </div>
          <h3 class="card-title font-head">{p.title}</h3>
          <p class="card-desc">{p.description}</p>
          {p.flagship && p.demoLinks && (
            <div class="card-demos">
              {p.demoLinks.map(d => (
                <a href={d.url} target="_blank" rel="noopener noreferrer" class="demo-link demo-link--flagship" onclick="event.stopPropagation()">
                  {d.label}
                </a>
              ))}
            </div>
          )}
          {!p.flagship && p.demoLinks && (
            <div class="card-demos">
              {p.demoLinks.map(d => (
                <a href={d.url} target="_blank" rel="noopener noreferrer" class="demo-link" onclick="event.stopPropagation()">
                  {d.label} ↗
                </a>
              ))}
            </div>
          )}
          <div class="card-bottom">
            <div class="card-tags">
              {p.tags.map(t => <span class="tag font-mono">{t}</span>)}
            </div>
            {p.liveUrl
              ? <span class="card-arrow card-arrow--live">Live Demo ↗</span>
              : <span class="card-arrow">{p.isVideo ? '▶ демо' : 'GitHub →'}</span>
            }
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-section {
    padding: 5rem 0;
    background: var(--bg-dark2);
  }

  .section-header { margin-bottom: 2.5rem; }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 0.75rem;
  }
  .section-label::before {
    content: '';
    display: inline-block;
    width: 20px; height: 2px;
    background: var(--orange);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border-dark);
    border: 1px solid var(--border-dark);
    border-radius: 8px;
    overflow: hidden;
  }

  .project-card {
    background: var(--bg-dark);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    text-decoration: none;
    transition: background 0.2s;
    cursor: pointer;
  }

  .project-card:hover { background: rgba(255,85,0,0.07); }
  .project-card:hover .card-arrow { color: var(--orange); }

  .project-card--flagship {
    background: linear-gradient(135deg, rgba(255,85,0,0.08) 0%, var(--bg-dark) 60%);
    border-bottom: 2px solid rgba(255,85,0,0.35);
  }
  .project-card--flagship:hover {
    background: linear-gradient(135deg, rgba(255,85,0,0.14) 0%, rgba(255,85,0,0.05) 60%);
  }
  .project-card--flagship .card-title {
    font-size: 1.15rem;
  }

  .card-flagship {
    font-size: 0.55rem;
    color: var(--orange);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-top-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .card-id {
    font-size: 0.6rem;
    color: rgba(255,255,255,0.2);
    letter-spacing: 0.1em;
  }

  .card-type {
    font-size: 0.6rem;
    color: var(--orange);
    background: rgba(255,85,0,0.12);
    border: 1px solid rgba(255,85,0,0.25);
    padding: 0.1rem 0.4rem;
    border-radius: 99px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-on-dark);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.82rem;
    color: var(--text-on-dark-secondary);
    line-height: 1.7;
    flex: 1;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-dark);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .tag {
    font-size: 0.58rem;
    padding: 0.12rem 0.45rem;
    border-radius: 99px;
    border: 1px solid var(--border-dark);
    color: rgba(255,255,255,0.35);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card-arrow {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.3);
    flex-shrink: 0;
    font-family: 'IBM Plex Mono', monospace;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .card-arrow--live {
    color: var(--orange);
    opacity: 0.7;
  }
  .project-card:hover .card-arrow--live { opacity: 1; }

  .card-demos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .demo-link {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--orange);
    text-decoration: none;
    border: 1px solid rgba(255,85,0,0.35);
    border-radius: 99px;
    padding: 0.15rem 0.55rem;
    transition: background 0.2s, color 0.2s;
  }
  .demo-link:hover {
    background: rgba(255,85,0,0.15);
    color: #fff;
  }

  .demo-link--flagship {
    font-size: 0.68rem;
    padding: 0.2rem 0.7rem;
    border-color: rgba(255,85,0,0.5);
    color: var(--orange);
  }
  .demo-link--flagship:hover {
    background: rgba(255,85,0,0.2);
    color: #fff;
  }

  @media (max-width: 860px) {
    .projects-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>
