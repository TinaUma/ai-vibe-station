---

<section id="projects" class="projects-section">
  <div class="container-site">
    <div class="section-header">
      <span class="section-label">projects</span>
      <h2 class="section-title section-title--light">Проекты</h2>
    </div>
    <div class="projects-grid">
      {projects.map(p => (
        <div class="project-card" role="link" tabindex="0" onclick={`window.open('${p.liveUrl ?? p.link}','_blank')`}>
          <div class="card-top">
            <span class="card-id font-mono">{p.id}</span>
            <span class="card-type font-mono">{p.type}</span>
          </div>
          <h3 class="card-title font-head">{p.title}</h3>
          <p class="card-desc">{p.description}</p>
          {p.demoLinks && (
            <div class="card-demos">
              {p.demoLinks.map(d => (
                <a href={d.url} target="_blank" rel="noopener noreferrer" class="demo-link" onclick="event.stopPropagation()">
                  {d.label} ↗
                </a>
              ))}
            </div>
          )}
          <div class="card-bottom">
            <div class="card-tags">
              {p.tags.map(t => <span class="tag font-mono">{t}</span>)}
            </div>
            {p.liveUrl
              ? <span class="card-arrow card-arrow--live">Live Demo ↗</span>
              : <span class="card-arrow">{p.isVideo ? '▶ демо' : 'GitHub →'}</span>
            }
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-section {
    padding: 5rem 0;
    background: var(--bg-dark2);
  }

  .section-header { margin-bottom: 2.5rem; }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 0.75rem;
  }
  .section-label::before {
    content: '';
    display: inline-block;
    width: 20px; height: 2px;
    background: var(--orange);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border-dark);
    border: 1px solid var(--border-dark);
    border-radius: 8px;
    overflow: hidden;
  }

  .project-card {
    background: var(--bg-dark);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    text-decoration: none;
    transition: background 0.2s;
    cursor: pointer;
  }

  .project-card:hover { background: rgba(255,85,0,0.07); }
  .project-card:hover .card-arrow { color: var(--orange); }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .card-id {
    font-size: 0.6rem;
    color: rgba(255,255,255,0.2);
    letter-spacing: 0.1em;
  }

  .card-type {
    font-size: 0.6rem;
    color: var(--orange);
    background: rgba(255,85,0,0.12);
    border: 1px solid rgba(255,85,0,0.25);
    padding: 0.1rem 0.4rem;
    border-radius: 99px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-on-dark);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .card-desc {
    font-size: 0.82rem;
    color: var(--text-on-dark-secondary);
    line-height: 1.7;
    flex: 1;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-dark);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .tag {
    font-size: 0.58rem;
    padding: 0.12rem 0.45rem;
    border-radius: 99px;
    border: 1px solid var(--border-dark);
    color: rgba(255,255,255,0.35);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .card-arrow {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.3);
    flex-shrink: 0;
    font-family: 'IBM Plex Mono', monospace;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .card-arrow--live {
    color: var(--orange);
    opacity: 0.7;
  }
  .project-card:hover .card-arrow--live { opacity: 1; }

  .card-demos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .demo-link {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    color: var(--orange);
    text-decoration: none;
    border: 1px solid rgba(255,85,0,0.35);
    border-radius: 99px;
    padding: 0.15rem 0.55rem;
    transition: background 0.2s, color 0.2s;
  }
  .demo-link:hover {
    background: rgba(255,85,0,0.15);
    color: #fff;
  }

  @media (max-width: 860px) {
    .projects-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .projects-grid { grid-template-columns: 1fr; }
  }
</style>
